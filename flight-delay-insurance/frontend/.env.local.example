# ---------------------------------------------------------------------------
# LOCAL DEMO MODE (Anvil, default)
# Set these to run the app against a local Anvil chain (chainId 407150). Anvil
# signs everything with its standard dev accounts, so no real testnet funds or
# proof pipeline are needed — settlement uses PolicyManager.settleForTesting().
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USE_LOCAL_SIM=true
NEXT_PUBLIC_CREDITCOIN_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CREDITCOIN_CHAIN_ID=407150
CREDITCOIN_RPC_URL=http://127.0.0.1:8545     # server-side settle route
SEPOLIA_CHAIN_KEY=1

# Local anvil default deployer account #0 private key (anvil prints this at startup)
SETTLER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed contract addresses (fill in from the local deploy output)
NEXT_PUBLIC_MOCK_USDC_ADDRESS=
NEXT_PUBLIC_POLICY_MANAGER_ADDRESS=
NEXT_PUBLIC_LIQUIDITY_POOL_ADDRESS=
NEXT_PUBLIC_FLIGHT_DELAY_REPORTER_ADDRESS=0x0000000000000000000000000000000000000000

# Server-side values required at runtime even in local mode:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
REPORTER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# REAL TESTNET MODE
# To switch to the live Creditcoin CC3 / Sepolia flow, flip these overrides:
#   NEXT_PUBLIC_USE_LOCAL_SIM=false
#   NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
#   NEXT_PUBLIC_CREDITCOIN_CHAIN_ID=40715
#   CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# Then fill in REPORTER_PRIVATE_KEY / SETTLER_PRIVATE_KEY with real testnet keys,
# set NEXT_PUBLIC_FLIGHT_DELAY_REPORTER_ADDRESS to the deployed Sepolia reporter,
# and set SEPOLIA_CHAIN_KEY via `cd ../offchain && npm run check-chains`.
# ---------------------------------------------------------------------------
