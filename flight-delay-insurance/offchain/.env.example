# Source chain (Sepolia) RPC
SEPOLIA_RPC_URL=

# Creditcoin CC3 testnet RPC (public: https://rpc.cc3-testnet.creditcoin.network)
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Attestcoin Protocol Proof Builder service for CC3 testnet
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Chain key for Ethereum Sepolia as recognized by Creditcoin's ChainInfo precompile.
# Confirm this via PrecompileChainInfoProvider.getSupportedChains() -- do not assume it is
# always 1; look it up before relying on it (see scripts/checkSupportedChains.ts).
SEPOLIA_CHAIN_KEY=1

# Deployed contract addresses (fill in after running the Foundry deploy scripts)
FLIGHT_DELAY_REPORTER_ADDRESS=
SOURCE_REPORTER_CONTRACT=
POLICY_MANAGER_ADDRESS=
LIQUIDITY_POOL_ADDRESS=
MOCK_USDC_ADDRESS=

# Private keys (testnet only -- never commit real keys)
REPORTER_PRIVATE_KEY=
SETTLER_PRIVATE_KEY=
